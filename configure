#!/bin/sh

set -eu

# The deployed image advertises Chrome to chromote and/or pagedown. When either
# variable is set, this package installation is happening in a PDF-capable
# runtime, so exercise that runtime now. This runs while the Dockerfile installs
# EJAM and fails the image build if Chrome cannot actually produce a PDF.
if [ -n "${CHROMOTE_CHROME:-}" ] || [ -n "${PAGEDOWN_CHROME:-}" ] || [ "${EJAM_PDF_BUILD_SMOKE_TEST:-}" = "true" ]; then
  echo "Running EJAM PDF build smoke test"
  Rscript --vanilla -e 'source("R/pdf_smoke_test.R", local = TRUE); smoke_test_pdf_runtime()'
fi
